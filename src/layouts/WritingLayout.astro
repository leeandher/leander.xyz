---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout>
  <header class="my-16 text-center">
    <h1 class="font-fancy text-6xl text-base">
      {frontmatter.title}
    </h1>
    <p class="font-sans text-1xl text-base/70 mt-2">
      {frontmatter.description}
    </p>
  </header>
  <article
    class="max-w-4xl px-6 py-10 m-auto shadow-2xl prose prose-a:text-link"
  >
    <slot />
  </article>
</Layout>
