---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout>
  <header class="my-16">
    <h1 class="font-fancy text-6xl text-base">
      {frontmatter.title}
    </h1>
    <p class="font-sans text-1xl text-base/70 mt-2">
      {frontmatter.description}
    </p>
  </header>
  <article class="max-w-4xl px-6 py-10 m-auto text-base">
    <slot />
  </article>
</Layout>

<style>
  article :global(p) {
    margin: var(--writing-margin) 0;
  }
  article :global(h1) {
    font-size: 36px;
    font-weight: bold;
    margin: var(--writing-margin) 0;
  }
  article :global(h2) {
    font-size: 28px;
    font-weight: bold;
    margin: var(--writing-margin) 0;
  }
  article :global(h3) {
    font-size: 22px;
    font-weight: bold;
    margin: var(--writing-margin) 0;
  }
  article :global(h4) {
    font-size: 18px;
    font-weight: bold;
    margin: var(--writing-margin) 0;
  }
  article :global(img) {
    margin: var(--writing-margin) 0;
  }
  article :global(kbd) {
    border: 1px solid var(--color-base);
    box-shadow: 0 2px 0 var(--color-base);
    padding: var(--writing-span-margin);
    border-radius: var(--writing-border-radius);
  }
  article :global(pre) {
    margin: var(--writing-margin) 0;
    padding: var(--writing-margin) var(--writing-indent-margin);
    border-radius: var(--writing-border-radius);
    border: 2px solid var(--color-base);
  }
  article :global(ol) {
    list-style-type: decimal;
    list-style-position: inside;
    padding-inline-start: var(--writing-indent-margin);
    margin: var(--writing-margin) 0;
  }
  article :global(ul) {
    list-style-type: disc;
    list-style-position: inside;
    padding-inline-start: var(--writing-indent-margin);
    margin: var(--writing-margin) 0;
  }
  article :global(hr) {
    color: var(--color-base);
    margin: var(--writing-margin) 0;
  }
  article :global(table) {
    margin: var(--writing-margin) 0;
  }

  article :global(th) {
    border: 1px solid var(--color-base);
    background: var(--color-base-alt);
    color: var(--color-surface);
    padding: var(--writing-span-margin) 0;
    padding-inline: var(--writing-indent-margin);
  }

  article :global(td) {
    border: 1px solid var(--color-base);
    padding: var(--writing-span-margin);
  }

  article :global(:not(thead) > tr:nth-child(even)) {
    background: var(--color-surface-alt);
  }

  article :global(blockquote) {
    position: relative;
    font-family: var(--font-fancy);
    font-size: 1.125rem;
    margin: var(--writing-margin) 0;
    padding-inline-start: var(--writing-indent-margin);
    &:before {
      position: absolute;
      content: "";
      left: 0;
      height: 100%;
      width: var(--writing-span-margin);
      border-radius: var(--writing-span-margin);
      background: var(--color-pop);
    }
  }

  article :global(:not(pre) > code) {
    background: var(--color-base);
    color: var(--color-surface);
    padding: var(--writing-span-margin);
    border-radius: var(--writing-border-radius);
  }

  article :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    &:hover,
    &:focus,
    &:active {
      text-decoration: none;
    }
  }

  article :global(mark) {
    position: relative;
    color: var(--color-base);
    background: unset;
    padding-inline: var(--writing-span-margin);
    border-radius: var(--writing-border-radius) var(--writing-border-radius) 0 0;
    border-bottom: 2px solid var(--color-pop);
    background: rgba(var(--color-pop-rgb), 0.2);
  }

  article :global(::selection) {
    background: rgba(var(--color-pop-rgb), 0.2);
  }
</style>
