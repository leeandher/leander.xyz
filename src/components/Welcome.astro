---
import Landscape from "./Landscape.svelte";
import DancingText from "./DancingText.svelte";
---

<Landscape client:only="svelte" />
<main>
  <section>
    <div class="mx-16 my-auto h-screen flex flex-col justify-center">
      <p class="font-fancy text-4xl text-base/70">heyyo. welcome to</p>
      <DancingText
        client:load
        text="leander.xyz"
        element="h1"
        class="font-fancy text-8xl text-base"
      />
      <p class="font-sans text-xl text-base mt-2">
        got a bunch of stuff around here for you to check out.
      </p>
    </div>
  </section>
</main>
