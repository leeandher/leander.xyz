---
import DancingText from "./DancingText.svelte";
---

<section class="mx-16 h-screen flex flex-col justify-center">
  <p class="font-fancy text-4xl text-base/70">heyyo. welcome to</p>
  <div class="mx-auto">
    <div class="font-fancy text-8xl inline-block text-base" aria-hidden>
      <span class="text-snap">w</span><span class="text-crackle">w</span><span
        class="text-pop">w</span
      >.
    </div>
    <DancingText
      client:load
      text="leander.xyz"
      element="h1"
      class="font-fancy text-8xl text-base inline-block"
    />
  </div>
  <p class="font-sans text-l text-base mt-4 text-right">
    my name is leander rodrigues. <br />this is my corner of the internet. <br
    />and i got some stuff around here.
  </p>
</section>
