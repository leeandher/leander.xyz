---
import DancingText from "src/components/DancingText.svelte";
---

<section class="mx-4 h-screen flex flex-col justify-center">
  <div class="mx-auto whitespace-nowrap">
    <p
      class="font-fancy text-base/70 text-2xl sm:text-3xl mb-0 lg:text-4xl lg:-mb-10"
    >
      heyyo. welcome to
    </p>
    <div
      class="font-fancy text-base inline-block text-5xl sm:text-7xl lg:text-9xl"
    >
      <a class="text-snap" href="/writings">w</a><a
        class="text-crackle"
        href="/wares">w</a
      ><a class="text-pop" href="/work">w</a>.
    </div>
    <DancingText
      client:load
      text="leander.xyz"
      element="h1"
      class="font-fancy text-base inline-block text-5xl sm:text-7xl lg:text-9xl"
    />
    <p class="mt-4 font-sans text-base/70 text-right">
      my name is leander rodrigues,
      <br />and this is my corner of the internet.
    </p>
  </div>
</section>
